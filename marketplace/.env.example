# ============ Base de données ============
DATABASE_URL=jdbc:postgresql://localhost:5432/marketplace
DATABASE_USERNAME=marketplace
DATABASE_PASSWORD=change-me

# ============ JWT (obligatoire : 32 caractères minimum) ============
JWT_SECRET=change-me-minimum-32-characters-0123456789abcdef
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ============ CORS / URLs ============
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# ============ Stockage d'images (Phase 1 : abstraction StorageProvider) ============
STORAGE_PROVIDER=local
CLOUDINARY_URL=

# ============ Paiement (NON implémenté — préparation uniquement) ============
PAYMENT_PROVIDER=
PAYMENT_API_KEY=

# ============ Carte (Leaflet/OpenStreetMap par défaut) ============
MAP_PROVIDER=osm

# ============ Mentions légales ============
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=
LEGAL_COUNTRY=Togo
PRIVACY_POLICY_VERSION=1
TERMS_VERSION=1
